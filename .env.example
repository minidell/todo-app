# Copy this file to .env and adjust values before running docker compose.
# .env is gitignored; never commit real secrets.

# --- database ---
# todo/todo matches the backend Settings default and the Playwright/local-dev
# defaults so `cp .env.example .env` works out of the box. Local dev only —
# change the password for any host that isn't your own machine.
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo
DB_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://todo:todo@db:5432/todo

# --- backend ---
APP_ENV=dev
BACKEND_HOST_PORT=8010
MAX_BODY_BYTES=65536
# required, >=32 chars; generate: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_MINUTES=60
CORS_ORIGINS=http://localhost:5173
# The event broker (realtime SSE) is in-process; `memory` is the only accepted value
# and it implies exactly ONE backend replica — do not `--scale backend=N`, see README
# "Realtime". A future distributed backend (e.g. `redis`) would be an additive change.
REALTIME_BACKEND=memory
# Trust the last hop of the X-Forwarded-For header set by the reverse proxy (nginx).
# The backend reads only that last hop, not X-Real-IP (nginx sets X-Real-IP too, but the
# backend ignores it). In docker-compose, backend is always behind nginx, so default is
# true. For local development without docker, keep false (direct connection, no proxy
# headers). A planned TRUSTED_PROXY_CIDRS setting (default: loopback + private ranges)
# will further restrict which upstream sockets are allowed to set forwarded headers.
# TRUST_PROXY_HEADERS=false

# --- frontend ---
FRONTEND_HOST_PORT=5173

# --- ai (compose profile "ai" — optional; `docker compose --profile ai up -d`) ---
# The app is fully usable without this profile. Set AI_ENABLED=false to hide every
# AI feature in the UI even if the ai profile happens to be running.
AI_ENABLED=true
AI_AGENT_HOST_PORT=8020
AI_AGENT_URL=http://ai-agent:8000
# Shared secret between backend and ai-agent, never exposed to the browser.
# generate: openssl rand -hex 32 (>=32 chars; required when AI_ENABLED=true)
AI_AGENT_TOKEN=
AI_TIMEOUT_SECONDS=50
# Pinned Ollama image, not `:latest` (iteration 4, IT3-6) — `:latest` drifts silently
# and can trigger an unplanned network pull or run a different Ollama than this stack
# was verified against. Default below is digest-pinned from what was already cached on
# the reference host (no matching `ollama/ollama:<version>` tag was cached locally, so
# a version tag could not be pinned instead). To re-pin on your own host:
#   1. docker run --rm ollama/ollama:latest --version   (or: docker compose --profile
#      ai exec ollama ollama --version, if the stack is already up)
#   2. docker image inspect ollama/ollama:<version>      -> if found, use that tag
#   3. otherwise: docker image inspect ollama/ollama:latest \
#        --format '{{index .RepoDigests 0}}'             -> use that digest
# Never guess a tag or let `up` trigger a first-time pull of an unpinned image.
OLLAMA_IMAGE=ollama/ollama@sha256:020e4134285e2ef4d8fd801234176de3b4faadc992a3eb06c8e66a2f9d4c4ba2
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=45
# How long Ollama keeps a model loaded in memory after use. ollama-pull also warms the
# model on first `--profile ai up` so the first real request doesn't pay the cold-load
# cost. Lower this if the host is short on RAM and the model doesn't need to stay hot.
OLLAMA_KEEP_ALIVE=24h
